{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sar-drone-prototype/schemas/detection.schema.json",
  "title": "Detection",
  "description": "A single detection event emitted by the inference-service.",
  "type": "object",
  "required": ["id", "class", "confidence", "bbox", "frame_id", "source", "timestamp"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique detection id (UUID recommended)."
    },
    "class": {
      "type": "string",
      "enum": ["person", "fire", "flood", "debris", "structural_damage"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "bbox": {
      "type": "object",
      "description": "Normalized [0,1] axis-aligned bounding box.",
      "required": ["x", "y", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "w": { "type": "number", "minimum": 0, "maximum": 1 },
        "h": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "frame_id": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": ["rgb", "thermal"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "track_id": {
      "type": ["string", "null"],
      "description": "Stable tracking ID across frames (e.g. '1', 'track_001')."
    },
    "modalities": {
      "type": ["array", "null"],
      "description": "Sensor modalities that contributed to this detection.",
      "items": {
        "type": "string",
        "enum": ["rgb", "thermal"]
      }
    },
    "model_version": {
      "type": ["string", "null"],
      "description": "Version string of the inference model that produced this detection."
    },
    "timings_ms": {
      "type": ["object", "null"],
      "description": "Per-stage processing timings in milliseconds.",
      "additionalProperties": false,
      "properties": {
        "decode": { "type": "number" },
        "preprocess": { "type": "number" },
        "inference": { "type": "number" },
        "postprocess": { "type": "number" },
        "publish": { "type": "number" },
        "total": { "type": "number" }
      }
    }
  }
}
