{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CoverageGeoJSON",
  "description": "GeoJSON FeatureCollection representing mission area coverage grid cells",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["FeatureCollection"]
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "geometry", "properties"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["Feature"]
          },
          "geometry": {
            "type": "object",
            "required": ["type", "coordinates"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["Polygon"]
              },
              "coordinates": {
                "type": "array"
              }
            }
          },
          "properties": {
            "type": "object",
            "required": ["cell_id", "observation_count", "best_confidence", "searched"],
            "properties": {
              "cell_id": { "type": "string" },
              "observation_count": { "type": "integer", "minimum": 0 },
              "last_observed_at": { "type": ["string", "null"] },
              "best_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "searched": { "type": "boolean" },
              "staleness_seconds": { "type": ["number", "null"], "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
