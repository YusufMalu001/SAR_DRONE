{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HazardZonesGeoJSON",
  "description": "GeoJSON FeatureCollection representing buffered hazard zones with severity",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["FeatureCollection"]
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "id", "geometry", "properties"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["Feature"]
          },
          "id": {
            "type": "string"
          },
          "geometry": {
            "type": "object",
            "required": ["type", "coordinates"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["Polygon", "MultiPolygon", "Point"]
              },
              "coordinates": {
                "type": "array"
              }
            }
          },
          "properties": {
            "type": "object",
            "required": ["id", "class", "severity", "buffer_meters", "area_sq_m", "detection_count"],
            "properties": {
              "id": { "type": "string" },
              "class": {
                "type": "string",
                "enum": ["fire", "flood", "debris", "structural_damage", "power_line"]
              },
              "severity": {
                "type": "string",
                "enum": ["critical", "high", "medium", "low"]
              },
              "buffer_meters": { "type": "number", "minimum": 0 },
              "area_sq_m": { "type": "number", "minimum": 0 },
              "detection_count": { "type": "integer", "minimum": 0 },
              "feature_type": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
